# Copy this file to .env and fill in your own values. .env is gitignored.

# ── M1 (CLI) ────────────────────────────────────────────────────────────────
ACTIVE_PROFILE=example

# Claude API — required, used for English-workplace classification
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Adzuna — free at https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── M2 (web app) ────────────────────────────────────────────────────────────
# Required in production — signs session cookies + magic-link tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Optional — defaults to a local SQLite file (jobfighter.db) if unset.
# DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname

# Optional — magic-link/digest emails print to the server console if
# unset. Set for real delivery: https://resend.com
# RESEND_API_KEY=
# EMAIL_FROM=JobFighter <onboarding@resend.dev>

# Optional — JSearch (RapidAPI), second source, covers LinkedIn + Glassdoor
# RAPIDAPI_KEY=
