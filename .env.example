# Copy this file to .env and fill in your own values. .env is gitignored.

# ── M1 (CLI) ────────────────────────────────────────────────────────────────
ACTIVE_PROFILE=example

# Claude API — required, used for English-workplace classification
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Adzuna — free at https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── M2 (web app) ────────────────────────────────────────────────────────────
# Required in production — signs session cookies + magic-link tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Optional — defaults to a local SQLite file (jobfighter.db) if unset.
# DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname

# Optional — magic-link/digest emails print to the server console if
# unset. Set for real delivery: https://resend.com
# RESEND_API_KEY=
# EMAIL_FROM=JobFighter <onboarding@resend.dev>

# Optional — JSearch (RapidAPI), second source, covers LinkedIn + Glassdoor
# RAPIDAPI_KEY=

# ── M3 (scheduler + git archive) ─────────────────────────────────────────────
# Sweep entrypoint: `python -m scheduler.run_due_profiles` — invoke this
# periodically from the host's own scheduler (Render Cron Job / OS cron),
# it is not a long-running daemon itself.

# How many profiles' pipelines the sweep runs concurrently. Default: 3.
# SCHEDULER_MAX_CONCURRENT_RUNS=3

# Per-source_type shared API quota (docs/architecture.md's API-budget
# note) — defaults to 60 calls/60s per source if unset.
# RATE_LIMIT_ADZUNA_MAX_CALLS=60
# RATE_LIMIT_ADZUNA_PERIOD_SECONDS=60
# RATE_LIMIT_JSEARCH_MAX_CALLS=60
# RATE_LIMIT_JSEARCH_PERIOD_SECONDS=60

# Path to a local checkout of the separate `jobfighter-data` repo. Unset
# (default) = archiving is a documented no-op, safe for local dev/CI.
# JOBFIGHTER_DATA_REPO_PATH=
# GIT_ARCHIVE_BOT_NAME=jobfighter-bot
# GIT_ARCHIVE_BOT_EMAIL=bot@jobfighter.local
# GIT_ARCHIVE_REMOTE=origin
# GIT_ARCHIVE_PUSH=true
