# Copy this file to .env and fill in your own values. .env is gitignored.

# ── M1 (CLI) ────────────────────────────────────────────────────────────────
ACTIVE_PROFILE=example

# Claude API — required, used for English-workplace classification
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Adzuna — free at https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── M2+ (web app, not needed for M1) ─────────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname
# SESSION_SECRET=
# RESEND_API_KEY=
# RAPIDAPI_KEY=                     # JSearch — LinkedIn + Glassdoor coverage
